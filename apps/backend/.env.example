# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://rental:rental123@localhost:5432/rental_platform"
SHADOW_DATABASE_URL="postgresql://rental:rental123@localhost:5432/rental_platform_shadow"

# ── Authentication ────────────────────────────────
# Must be at least 32 characters
JWT_SECRET="change-this-to-a-very-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Cloudinary (image uploads) ────────────────────
# Get free credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Ethiopian Payment Providers (sandbox) ─────────
CBE_BIRR_API_KEY=
TELEBIRR_API_KEY=
MPESA_API_KEY=

# ── Trust System ──────────────────────────────────
TRUST_SCORE_INITIAL="50"
TRUST_SCORE_VERIFICATION_BONUS="20"
