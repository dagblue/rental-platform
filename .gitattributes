# Auto-detect text files and normalize line endings to LF on all platforms
* text=auto eol=lf

# Windows batch files must stay CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
